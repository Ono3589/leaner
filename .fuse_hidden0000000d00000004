/* ---------- COACH ---------- */

/* Der Coach als Gegenüber statt als Chatfenster.

   Sichtbar ist immer nur die aktuelle Antwort — groß genug zum
   ruhigen Lesen, ohne dass etwas wegscrollt. Der Verlauf bleibt
   erhalten und liegt hinter einem Knopf; man braucht ihn selten,
   aber wenn, dann richtig. */
function renderCoach() {
  if (!S.chat.length) S.chat = [{ role: 'ai', text: DATA.coachGreeting }];

  const lastAsk = [...S.chat].reverse().find((m) => m.role === 'me');
  const lastSay = [...S.chat].reverse().find((m) => m.role === 'ai');

  view.innerHTML = `
    <div class="orb-stage"><canvas id="orb"></canvas></div>

    <div class="orb-ask" id="orbAsk">${lastAsk ? escapeHtml(lastAsk.text) : ''}</div>
    <div id="orbSay" class="orb-say">${lastSay ? msgBody(lastSay.text) : ''}</div>

    <div class="section">
      <div class="suggestions" id="suggs">
        ${DATA.coachSuggestions.map((s) => `<button class="sugg">${s}</button>`).join('')}
      </div>
    </div>

    <div class="orb-tools">
      <button class="btn btn-sm btn-ghost" id="histBtn">${icon('message')} Verlauf</button>
      ${S.chat.length > 1 ? `<button class="btn btn-sm btn-ghost" id="clearBtn">Neu anfangen</button>` : ''}
    </div>

    <div style="height:80px"></div>
    <div class="composer">
      <textarea id="input" rows="1" placeholder="Frag mich was…" enterkeyhint="send"></textarea>
      <button class="send" id="sendBtn" aria-label="Senden">${icon('send')}</button>
    </div>
  `;

  Avatar.mount(document.getElementById('orb'));
  Avatar.setTone(lastAsk ? topicOf(lastAsk.text) : 'accent');

  const input = document.getElementById('input');
  const askEl = document.getElementById('orbAsk');
  const sayEl = document.getElementById('orbSay');

  const send = (text) => {
    text = (text || input.value).trim();
    if (!text) return;
    input.value = '';
    input.style.height = 'auto';
    input.blur();

    S.chat.push({ role: 'me', text });
    S.coachAsks++;
    save();
    checkBadges();

    askEl.textContent = text;
    Avatar.setTone(topicOf(text));
    Avatar.setState('thinking');
    sayEl.innerHTML = `<div class="orb-thinking">
      <span class="typing"><i></i><i></i><i></i></span> denkt nach</div>`;
    window.scrollTo({ top: 0, behavior: 'smooth' });

    askCoach(text).catch(() => DATA.coachFallback).then((reply) => {
      S.chat.push({ role: 'ai', text: reply });
      save();
      Avatar.setState('talking');
      sayEl.innerHTML = msgBody(reply);
      haptic(8);
      // Nach dem Antworten wieder zur Ruhe kommen
      setTimeout(() => Avatar.setState('idle'), 2600);
    });
  };

  document.getElementById('sendBtn').addEventListener('click', () => send());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(110, input.scrollHeight) + 'px';
  });
  document.getElementById('suggs').addEventListener('click', (e) => {
    const b = e.target.closest('.sugg');
    if (b) send(b.textContent);
  });

  document.getElementById('histBtn').addEventListener('click', openHistory);

  const clear = document.getElementById('clearBtn');
  if (clear) clear.addEventListener('click', () => {
    if (!confirm('Den bisherigen Verlauf verwerfen?')) return;
    S.chat = [{ role: 'ai', text: DATA.coachGreeting }];
    save(); renderCoach();
  });

  // Kurzes Antippen des Kreises holt einen Vorschlag
  document.getElementById('orb').addEventListener('click', () => {
    if (Avatar.state === 'thinking') return;
    haptic(6);
    send(DATA.coachSuggestions[Math.floor(Math.random() * DATA.coachSuggestions.length)]);
  });
}

function openHistory() {
  openSheet(`
    <h2 class="sheet-title">Verlauf</h2>
    <p class="muted small" style="margin:0 0 16px">${S.chat.length} Nachrichten</p>
    <div class="chat">${S.chat.map(msgHtml).join('')}</div>
  `);
  sheetBody.scrollTop = sheetBody.scrollHeight;
}

/* Textauszeichnung des Coaches in HTML übersetzen */
function msgBody(text) {
  return String(text)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\n/g, '<br>')
    .replace(/<br>(<ul>)/g, '$1')
    .replace(/(<\/ul>)<br>/g, '$1');
}

function msgHtml(m) {
  return `<div class="msg ${m.role === 'me' ? 'msg-me' : 'msg-ai'}">${msgBody(m.text)}</div>`;
}

/* Echter Coach über die Edge Function, mit Rückfall auf die
   Regelantworten — damit die App auch offline oder bei einem
   Backend-Ausfall etwas Sinnvolles sagt. */
async function askCoach(text) {
  if (Cloud.sb && Cloud.user && navigator.onLine) {
    try {
      return await Cloud.coach(S.chat.slice(-12), coachContext());
    } catch (e) {
      console.warn('Coach nicht erreichbar:', e.message || e);
      return localCoachReply(text) +
        `\n\n<i>Das kam aus meinem Offline-Wissen, weil der KI-Coach gerade nicht antwortet:\n` +
        `${escapeHtml(e.message || 'unbekannter Fehler')}\n` +
        `Unter Profil → Verbindung prüfen siehst du, woran es liegt.</i>`;
    }
  }
  // Ohne Backend kurz warten, damit es sich nicht nach Autotext anfühlt
  await new Promise((r) => setTimeout(r, 500 + Math.random() * 400));
  return localCoachReply(text);
}

function coachContext() {
  const quests = todayQuests();
  const adv = deficitAdvice(S.profile);
  const goal = macroTargets(S.profile);
  const eaten = dayTotals();

  return {
    level: levelInfo(S.xpTotal).level,
    xpTotal: S.xpTotal,
    streak: S.streak,
    bestStreak: S.bestStreak,
    doneToday: quests.filter((q) => S.doneToday.includes(q.id)).length,
    fastProtocol: (DATA.fasting.find((f) => f.id === S.fastProtocol) || {}).name,
    fasting: !!S.fastStart,
    cooked: S.cooked,
    workouts: S.workouts,
    mindful: S.mindful,
    localTime: new Date().toLocaleString('de-DE', { weekday: 'long', hour: '2-digit', minute: '2-digit' }),

    // Ernährung — nur mitschicken, was tatsächlich hinterlegt ist
    bmr: adv ? adv.bmr : null,
    tdee: adv ? adv.tdee : null,
    bmi: adv ? Number(adv.bmi.toFixed(1)) : null,
    deficit: S.profile.deficit || 0,
    targetKcal: goal ? goal.kcal : null,
    eatenToday: Math.round(eaten.kcal),
    proteinToday: Math.round(eaten.p),
    ownRecipes: (S.myRecipes || []).length
  };
}

/* Regelbasierte Ausweichantworten (data.js). */
function localCoachReply(text) {
  const rule = DATA.coachRules.find((r) => r.match.test(text));
  let base = rule ? rule.reply : DATA.coachFallback;

  // Kontext aus dem State — das macht den Coach persönlich
  if (rule && /streak/i.test(text) && S.bestStreak > 0) {
    base += `\n\n<i>Zur Einordnung: Dein Rekord liegt bei ${S.bestStreak} Tagen. Das hast du schon einmal gekonnt.</i>`;
  }
  if (!rule && S.doneToday.length === 0) {
    base += `\n\nÜbrigens: heute steht noch nichts auf deiner Liste. Ein Glas Wasser wären 5 XP in 30 Sekunden.`;
  }
  return base;
}

/* ------------------------------------------------------------
   Fortschrittsfotos

   Aussagekräftiger als die Waage, weil sie zeigen, was sich
   tatsächlich verändert — Gewicht schwankt tageweise um mehr,
   als in einem Monat an Fett dazukommt oder verschwindet.

   Gespeichert wird das Gewicht des Tages mit, damit später beides
   nebeneinander steht.
------------------------------------------------------------ */

let progressCache = null;

async function paintProgressPhotos() {
  const box = document.getElementById('progBox');
  if (!box) return;

  if (!progressCache) {
    box.innerHTML = '<div class="tiny faint">Wird geladen…</div>';
    try {
      progressCache = await Cloud.listProgressPhotos();
    } catch (e) {
      box.innerHTML = `<div class="tiny faint">Fotos nicht erreichbar. Wurde
        <b>schema-3.sql</b> schon ausgeführt?</div>`;
      return;
    }
  }

  if (!progressCache.length) {
    box.innerHTML = `<div class="card"><div class="tiny muted">
      Noch keine Fotos. Ein Bild alle zwei Wochen, gleiche Stelle, gleiches Licht —
      nach zwei Monaten siehst du mehr als auf jeder Waage.
    </div></div>`;
    return;
  }

  box.innerHTML = `<div class="prog-grid">
    ${progressCache.map((p) => `
      <button class="prog-item" data-prog="${p.id}">
        ${photoBox(p.path, '', 'user')}
        <span class="prog-date">${new Date(p.taken_on).toLocaleDateString('de-DE',
          { day: '2-digit', month: '2-digit', year: '2-digit' })}${
          p.weight_kg ? ' · ' + p.weight_kg + ' kg' : ''}</span>
      </button>`).join('')}
  </div>`;

  fillPhotos(box);

  box.querySelectorAll('[data-prog]').forEach((b) => b.addEventListener('click', async () => {
    const p = progressCache.find((x) => x.id === b.dataset.prog);
    if (!p) return;
    if (!confirm('Dieses Foto löschen?')) return;
    try {
      await Cloud.deleteProgressPhoto(p.id, p.path);
      progressCache = progressCache.filter((x) => x.id !== p.id);
      paintProgressPhotos();
      toast('Gelöscht');
    } catch (e) {
      toast('Löschen fehlgeschlagen');
    }
  }));
}

async function takeProgressPhoto() {
  try {
    const shot = await captureAndUpload('progress', (t) => toast(t, 'clock'));
    if (!shot) return;
    const row = await Cloud.addProgressPhoto(shot.path, S.profile.weightKg || null, null);
    progressCache = [row].concat(progressCache || []);
    haptic(10);
    toast(`Foto gespeichert · ${Math.round(shot.bytes / 1024)} KB`, 'check');
    paintProgressPhotos();
  } catch (e) {
    console.warn('Fortschrittsfoto:', e.message || e);
    toast('Foto konnte nicht gespeichert werden');
