  { id: 'mittag',      name: 'Mittagessen' },
  { id: 'abend',       name: 'Abendessen' },
  { id: 'snack',       name: 'Snacks' }
];

function allRecipes() {
  return DATA.recipes.concat(S.myRecipes || []);
}

function recipeById(id) {
  return allRecipes().find((r) => r.id === id);
}

/* Nährwerte und Score eines Rezepts — pro 100 g und pro Portion. */
function recipeInfo(r) {
  if (!r || !r.items || !r.items.length) return null;
  const n = recipeNutrition(r.items);
  if (!n) return null;
  const portions = Math.max(1, Number(r.portions) || 1);
  const score = nutriScore(n.per100, n.category);
  const per = {};
  ['kcal', 'p', 'ch', 'z', 'f', 'sf', 'b', 's'].forEach((k) => {
    per[k] = n.total[k] / portions;
  });
  per.g = n.total.g / portions;
  return { per100: n.per100, perPortion: per, portions, score, category: n.category };
}

function todayEntries() {
  return (S.diary && S.diary[S.todayKey]) || [];
}

function dayTotals(key) {
  const list = (S.diary && S.diary[key || S.todayKey]) || [];
  return list.reduce((a, e) => ({
    kcal: a.kcal + (e.kcal || 0),
    p: a.p + (e.p || 0),
    ch: a.ch + (e.ch || 0),
    f: a.f + (e.f || 0)
  }), { kcal: 0, p: 0, ch: 0, f: 0 });
}

function addDiaryEntry(entry) {
  const key = S.todayKey || dayKey();
  if (!S.diary) S.diary = {};
  if (!S.diary[key]) S.diary[key] = [];
  S.diary[key].push({ ...entry, eid: 'e' + Date.now() + Math.floor(Math.random() * 1000) });

  // Alles älter als 120 Tage wegräumen, damit der Datensatz nicht endlos wächst
  const keys = Object.keys(S.diary).sort();
  while (keys.length > 120) delete S.diary[keys.shift()];

  save();
}

function removeDiaryEntry(eid) {
  const key = S.todayKey;
  if (!S.diary || !S.diary[key]) return;
  S.diary[key] = S.diary[key].filter((e) => e.eid !== eid);
  save();
}

/* Ins Tagebuch eintragen, direkt aus einem Rezept heraus. */
function logRecipe(r, meal, factor = 1) {
  const info = recipeInfo(r);
  if (!info) { toast('Für dieses Rezept fehlen Nährwerte'); return false; }
  addDiaryEntry({
    name: r.name,
    recipeId: r.id,
    meal,
    portions: factor,
    kcal: Math.round(info.perPortion.kcal * factor),
    p: Math.round(info.perPortion.p * factor),
    ch: Math.round(info.perPortion.ch * factor),
    f: Math.round(info.perPortion.f * factor)
  });
  return true;
}

/* ------------------------------------------------------------
   Zutatensuche über drei Quellen

   1. eigene Zutaten und bereits übernommene Produkte  (sofort)
   2. die mitgelieferte Liste                          (sofort)
   3. Open Food Facts                                  (nachgereicht)

   Die ersten beiden erscheinen ohne Verzögerung, damit sich das
   Tippen nicht zäh anfühlt. Produkte werden erst nach einer
   Tippause geholt — sonst wäre das Ratelimit sofort erreicht.
------------------------------------------------------------ */

let productTimer = null;

function searchIngredients(query, render) {
  clearTimeout(productTimer);
  const q = query.trim();
  if (!q) { render([], false); return; }

  const local = findFoods(q, 10);
  render(local, q.length >= 3 && !!(Cloud.sb && Cloud.user && navigator.onLine));

  if (q.length < 3 || !Cloud.sb || !Cloud.user || !navigator.onLine) return;

  productTimer = setTimeout(async () => {
    try {
      const products = await Cloud.searchProducts(q);
      const known = new Set(local.map((f) => f.n.toLowerCase()));
      const fresh = products.filter((p) => !known.has(p.n.toLowerCase()));
      render(local.concat(fresh), false);
    } catch (e) {
      console.warn('Produktsuche:', e.message || e);
      render(local, false);
    }
  }, 450);
}

function foodResultHtml(f) {
  const off = f.source === 'openfoodfacts';
  const own = String(f.id).startsWith('cf:') || String(f.id).startsWith('local:');

  // Bei Gerichten ist die Portion die nützlichere Angabe als 100 g
  const herkunft = own ? 'Deine Zutat' : off ? 'Open Food Facts' : f.c;
  const menge = f.isDish
    ? `${f.portLbl} · ${f.port} g`
    : 'pro 100 g';
  const kcal = f.isDish
    ? Math.round(f.kcal * f.port / 100)
    : Math.round(f.kcal);

  return `<button class="sr" data-pick="${escapeHtml(f.id)}">
    ${f.photo ? photoBox(f.photo, 'sr-photo', 'image') : ''}
    <span class="grow">
      <div class="sr-name">${escapeHtml(f.n)}</div>
      <div class="sr-cat">${herkunft} · ${menge}</div>
    </span>
    ${off && f.offGrade ? scoreBadge(f.offGrade) : ''}
    <span class="sr-kcal">${kcal} kcal</span>
  </button>`;
}

/* Ein Produkt aus Open Food Facts dauerhaft übernehmen, damit
   Rezepte es später auflösen können, auch offline. */
async function adoptFood(food) {
  if (food.source !== 'openfoodfacts') return food;
  try {
    const saved = await Cloud.saveCustomFood(food);
    registerFoods([saved]);
    S.myFoods = (S.myFoods || []).filter((f) => f.id !== saved.id).concat([saved]);
    save();
    return saved;
  } catch (e) {
    // Speichern hat nicht geklappt — lokal weiterverwenden statt abbrechen
    console.warn('Zutat konnte nicht gespeichert werden:', e.message || e);
    registerFoods([food]);
    S.myFoods = (S.myFoods || []).concat([food]);
    save();
    return food;
  }
}

function scoreBadge(grade, big) {
  if (!grade) return '';
  return `<span class="ns ns-${grade}${big ? ' ns-lg' : ''}">${grade}</span>`;
}

function scoreScale(grade) {
  return `<div class="ns-scale">${['A', 'B', 'C', 'D', 'E']
    .map((g) => `<span class="ns-${g}${g === grade ? ' on' : ''}">${g}</span>`).join('')}</div>`;
}

