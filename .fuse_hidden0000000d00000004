/* Foto an einen Tagebucheintrag hängen. Ein Tippen, kein Umweg —
   wer unterwegs isst, fotografiert eher als er tippt. */
async function attachEntryPhoto(eid) {
  const list = (S.diary || {})[S.todayKey] || [];
  const entry = list.find((e) => e.eid === eid);
  if (!entry) return;

  if (entry.photo) {
    if (!confirm('Foto entfernen?')) return;
    Cloud.removePhoto(entry.photo);
    delete entry.photo;
    save(); renderDiary();
    return;
  }

  try {
    const shot = await captureAndUpload('diary', (t) => toast(t, 'clock'));
    if (!shot) return;
    entry.photo = shot.path;
    save();
    haptic(10);
    toast(`Foto gespeichert · ${Math.round(shot.bytes / 1024)} KB`, 'check');
    renderDiary();
  } catch (e) {
    console.warn('Foto:', e.message || e);
    toast('Foto konnte nicht gespeichert werden');
  }
}

function macroBar(name, value, goal, cls) {
